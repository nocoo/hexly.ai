{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!!public/logos",
			"!!public/icons",
			"!!public/brands/*/*/official-logo.*",
			"!!public/brands/*/*/guide.md",
			"!!artwork/brands/**/guide.md",
			"!!public/brands/*/*/source-*.json",
			"!!public/textures/*/*/source-*.json",
			"!!docs",
			"!!bun.lock",
			"!!artwork/logo-family/*/*/finishing",
			"!!artwork/logo-family/*/*/input",
			"!!artwork/logo-family/*/*/request.json",
			"!!artwork/logo-family/*/*/response.json",
			"!!artwork/brands/*/texture-studies/*/*/request.json",
			"!!artwork/brands/*/texture-studies/*/*/response.json",
			"!!artwork/logo-family/*/*/references/*.source.json",
			"!!artwork/brands/*/texture-studies/*/*/raw-review.json",
			"!!public/textures/*/v*/*-review.json",
			"!!public/textures/*/v*/provenance.json",
			"!!public/textures/*/v*/manifest.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["index.html"],
			"linter": {
				"rules": {
					"complexity": {
						"noArguments": "off"
					},
					"suspicious": {
						"noAssignInExpressions": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
