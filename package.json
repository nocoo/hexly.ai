{
	"name": "hexly.ai",
	"version": "1.8.3",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=24",
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 7048 --strictPort",
		"preview:worker": "bun scripts/local-status.ts preview",
		"deploy": "bun run build && bun run deploy:worker",
		"deploy:worker": "wrangler d1 migrations apply STATUS_DB --env \"\" --remote && wrangler deploy --env \"\"",
		"deploy:check": "wrangler deploy --env \"\" --dry-run",
		"verify:production": "bun scripts/verify-deployment.ts",
		"release": "bun scripts/release.ts",
		"media:r2": "bun scripts/media-r2.ts",
		"assets:r2": "bun scripts/asset-storage.ts",
		"assets:hydrate": "bun scripts/asset-storage.ts hydrate --scope all",
		"types": "mkdir -p .wrangler && wrangler types .wrangler/types.d.ts --env \"\" --strict-vars false",
		"typecheck": "bun run types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"lint": "biome check --error-on-warnings .",
		"check:focus": "bun scripts/check-test-focus.ts",
		"check:purity": "bun scripts/check-purity.ts",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "bun scripts/check-unit-asset-access.ts && vitest run --coverage",
		"test:assets": "vitest run --config vitest.config.assets.ts",
		"test:http": "bun run check:isolation && bun run build && playwright test --config playwright.http.config.ts",
		"test:browser": "bun run check:isolation && bun run build && playwright test",
		"assets:build": "bun scripts/generate-assets.ts && bun run social:build",
		"social:build": "bun scripts/create-social.ts",
		"social:check": "bun scripts/create-social.ts --check",
		"assets:check-tracked": "bun scripts/asset-storage.ts check-tracked",
		"assets:check": "bun run assets:check-tracked && bun run assets:hydrate && bun scripts/verify-assets.ts --history",
		"docs:profiles": "bun scripts/generate-profiles.ts && bun scripts/generate-textures.ts",
		"check:isolation": "bun scripts/verify-isolation.ts",
		"check:static": "bun scripts/gates.ts static",
		"check:security": "bun scripts/gates.ts security",
		"gate:commit": "bun scripts/gates.ts commit",
		"gate:push": "bun scripts/gates.ts push",
		"prepare": "husky",
		"assets:prepare-test": "bun scripts/prepare-test-assets.ts",
		"verify": "bun scripts/verify.ts",
		"docs:textures": "bun scripts/generate-textures.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@playwright/test": "1.65.0",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@vitest/coverage-v8": "5.1.0",
		"axe-core": "4.14.0",
		"husky": "9.1.7",
		"sharp": "0.35.5",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0",
		"wrangler": "4.156.0"
	},
	"overrides": {
		"fast-uri": "3.1.9",
		"undici": "7.30.1",
		"sharp": "0.35.5",
		"source-map-js": "1.2.2",
		"zod": "4.6.7"
	}
}
