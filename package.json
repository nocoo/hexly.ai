{
	"name": "hexly.ai",
	"version": "0.4.6",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": ">=24",
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 7048 --strictPort",
		"preview:worker": "wrangler dev --env \"\" --local --ip 127.0.0.1 --port 37048 --inspector-port 38048 --persist-to .wrangler/preview",
		"deploy": "bun run build && wrangler deploy --env \"\"",
		"deploy:check": "wrangler deploy --env \"\" --dry-run",
		"verify:production": "bun scripts/verify-deployment.ts",
		"release": "bun scripts/release.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"lint:staged": "biome check --staged --error-on-warnings --no-errors-on-unmatched",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:changed": "vitest run --changed --passWithNoTests",
		"test:coverage": "vitest run --coverage",
		"test:http": "bun run check:isolation && bun run build && playwright test --config playwright.http.config.ts",
		"test:browser": "bun run check:isolation && bun run build && playwright test",
		"assets:build": "bun scripts/generate-assets.ts && bun scripts/create-social.ts",
		"assets:social": "bun scripts/create-social.ts",
		"assets:check": "bun scripts/verify-assets.ts",
		"docs:profiles": "bun scripts/generate-profiles.ts",
		"check:isolation": "bun scripts/verify-isolation.ts",
		"check:static": "bun scripts/gates.ts static",
		"check:security": "bun scripts/gates.ts security",
		"gate:commit": "bun scripts/gates.ts commit",
		"gate:push": "bun scripts/gates.ts push",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "1.63.0",
		"@types/bun": "1.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.0",
		"husky": "9.1.7",
		"sharp": "0.35.4",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "5.0.0",
		"wrangler": "4.129.0"
	},
	"patchedDependencies": {
		"wrangler@4.129.0": "patches/wrangler@4.129.0.patch"
	}
}
