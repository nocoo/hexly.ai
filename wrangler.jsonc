{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hexly-ai",
	"compatibility_date": "2026-09-06",
	"main": "worker/gateway.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{ "pattern": "hexly.ai", "custom_domain": true },
		{ "pattern": "www.hexly.ai", "custom_domain": true }
	],
	"workers_dev": true,
	"dev": { "ip": "127.0.0.1", "port": 37048 },
	"observability": { "enabled": true },
	"env": {
		"test": {
			"name": "hexly-ai-test",
			"routes": [],
			"workers_dev": false
		}
	}
}
