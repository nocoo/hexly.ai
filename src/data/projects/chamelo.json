					"zh": "\u5934\u90e8\u81ea\u5de6\u7f18\u659c\u7740\u5165\u753b\uff0c\u50cf\u521a\u722c\u8fdb\u53d6\u666f\u6846\uff1b\u53f3\u4fa7\u6574\u7247\u7559\u767d\u662f\u6784\u56fe\u4e3b\u4f53\uff0c\u4e0d\u662f\u5269\u4f59\u8fb9\u8ddd\uff0c\u753b\u5e03 64% \u4fdd\u6301\u7a7a\u3002"
