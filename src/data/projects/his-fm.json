	"overview": {
		"goal": {
			"en": "Publish a Mandarin podcast whose collecting, editing, voicing, artwork and production are handled by AI roles. Each role reads versioned prompt slots and writes episodes back through a scoped Agent API instead of an in-site generator.",
			"zh": "\u53d1\u5e03\u4e00\u6863\u666e\u901a\u8bdd\u64ad\u5ba2\uff0c\u91c7\u96c6\u3001\u7f16\u8f91\u3001\u914d\u97f3\u3001\u5c01\u9762\u4e0e\u5236\u7247\u5206\u522b\u7531 AI \u89d2\u8272\u627f\u62c5\u3002\u5404\u89d2\u8272\u8bfb\u53d6\u53ef\u7248\u672c\u5316\u7684\u63d0\u793a\u8bcd\u69fd\uff0c\u5e76\u901a\u8fc7\u5e26\u4f5c\u7528\u57df\u7684 Agent API \u5199\u56de\u8282\u76ee\uff0c\u800c\u4e0d\u662f\u5728\u7ad9\u5185\u4e00\u952e\u751f\u6210\u3002"
		},
		"techStack": [
			{
				"name": "React / Vite",
				"role": {
					"en": "Listener site, player, transcript and admin console",
					"zh": "\u542c\u4f17\u7ad9\u70b9\u3001\u64ad\u653e\u5668\u3001\u9010\u5b57\u7a3f\u4e0e\u540e\u53f0"
				}
			},
			{
				"name": "Cloudflare Workers / D1 / R2",
				"role": {
					"en": "Worker gateway, episode database and media delivery",
					"zh": "Worker \u7f51\u5173\u3001\u8282\u76ee\u6570\u636e\u5e93\u4e0e\u5a92\u4f53\u5206\u53d1"
				}
			},
			{
				"name": "Prompt slots / Agent API",
				"role": {
					"en": "Versioned role prompts with scoped read and write tokens",
					"zh": "\u5e26\u4f5c\u7528\u57df\u8bfb\u5199\u4ee4\u724c\u7684\u7248\u672c\u5316\u89d2\u8272\u63d0\u793a\u8bcd"
				}
