	"overview": {
		"goal": {
			"en": "Provide a personal API key and token vault on Cloudflare Workers that dispatches low-sensitivity credentials on demand to Gemini, Claude Code, Cursor and CI agents over Streamable HTTP MCP, OAuth 2.1 + PKCE and headless Bot Bearer Tokens with folder/secret ACLs, AES-256-GCM encryption and 90-day audit retention.",
			"zh": "部署在 Cloudflare Workers 上的个人级 API Key / Token 托管服务，通过标准 Streamable HTTP MCP、OAuth 2.1 + PKCE 与无头 Bot Bearer Token 向 Gemini、Claude Code、Cursor 及自动化 Agent 按需分发低敏凭证，支持文件夹与单密钥细粒度授权、AES-256-GCM 加密及 90 天审计留存。"
		},
		"techStack": [
			{
				"name": "Hono / Cloudflare Workers",
				"role": {
					"en": "Streamable HTTP MCP endpoint, OAuth 2.1 authorization server and CF Access admin API",
					"zh": "Streamable HTTP MCP 服务端、OAuth 2.1 授权服务与 Cloudflare Access 管理接口"
				}
			},
			{
				"name": "D1 / KV / AES-256-GCM",
				"role": {
					"en": "Encrypted secret storage with per-secret IV/AAD, OAuth KV state and 90-day audit log pruning",
					"zh": "独立随机 IV 与 AAD 的 AES-256-GCM 密钥加密存储、OAuth KV 状态与 90 天定时审计清理"
				}
			},
			{
				"name": "React 19 / Vite 8 / Basalt",
				"role": {
					"en": "Amber-themed vault console and OAuth scope approval UI",
					"zh": "琥珀色主题密钥托管控制台与 OAuth 作用域授权界面"
				}
			}
		],
