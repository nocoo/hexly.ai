	"overview": {
		"goal": {
			"en": "Provide a TypeScript Agent and Workflow SDK aligned with the google-antigravity Python SDK, offering both an isolated uv stdio NDJSON bridge to the Antigravity localharness and a pure-TS Vercel AI SDK execution kernel behind one typed API.",
			"zh": "提供与 google-antigravity Python SDK 对齐的 TypeScript 智能体与工作流开发套件，以统一强类型接口封装 Antigravity uv stdio NDJSON 桥接与纯 TypeScript Vercel AI SDK 双执行内核。"
		},
		"techStack": [
			{
				"name": "TypeScript / Zod",
				"role": {
					"en": "Typed agent, tool, policy and structured-output contracts",
					"zh": "强类型智能体、工具、策略与结构化输出契约"
				}
			},
			{
				"name": "Antigravity Bridge (Python / uv)",
				"role": {
					"en": "Primary execution kernel over stdio NDJSON with BuiltinTools and sandboxing",
					"zh": "主执行内核，通过 stdio NDJSON 桥接完整内置工具与沙箱能力"
				}
			},
			{
				"name": "Vercel AI SDK",
				"role": {
					"en": "Zero-binary pure-TS OpenAI-compatible kernel",
					"zh": "零外部二进制依赖的纯 TS OpenAI 兼容执行内核"
				}
			}
		],
